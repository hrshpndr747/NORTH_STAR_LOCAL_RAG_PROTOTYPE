# Ollama runs locally. No document text is sent to an external AI service.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

DATA_DIR=data/confluence
INDEX_DIR=.rag_index
TOP_K=6
MIN_RELEVANCE=0.18

# Optional Confluence Cloud learning connector.
# Keep the real .env file private and never commit it.
CONFLUENCE_BASE_URL=https://your-company.atlassian.net
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEY=
CONFLUENCE_OUTPUT_DIR=data/confluence
CONFLUENCE_DOWNLOAD_ATTACHMENTS=true
CONFLUENCE_ATTACHMENT_MAX_MB=250
CONFLUENCE_ATTACHMENT_EXTENSIONS=.pdf,.docx,.xlsx,.vtt,.txt,.md,.csv,.json,.db,.sqlite,.sqlite3,.png,.jpg,.jpeg,.tif,.tiff,.bmp,.webp,.mp4,.mov,.mkv,.webm,.avi,.mp3,.wav,.m4a,.flac,.aac,.ogg

# Local image/scanned-PDF OCR and video/audio understanding.
MEDIA_AUTO_PROCESS_ON_INDEX=true
OCR_VISION_MODEL=qwen3.5:4b
PDF_OCR_MIN_CHARS=50
PDF_OCR_MAX_PAGES=100
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=auto
VIDEO_FRAME_ANALYSIS=true
VIDEO_FRAME_INTERVAL_SECONDS=5
VIDEO_MAX_FRAMES=100
